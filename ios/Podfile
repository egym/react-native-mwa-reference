# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ReactNativeMwaReference' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Autolinking adds the @egym/capacitor-mwa-navigation pod. These two plugins of the package are not on CocoaPods trunk.
  pod 'CapacitorCommunitySqlite', :path => '../node_modules/@egym/capacitor-mwa-navigation/node_modules/@capacitor-community/sqlite'
  pod 'CapacitorNFCPassWallet', :path => '../node_modules/@egym/capacitor-mwa-navigation/node_modules/@egym/capacitor-nfc-pass-wallet'
  # Swift pods of the package import these as static libraries, which needs module maps.
  pod 'SQLCipher', :modular_headers => true
  pod 'CapacitorKeyboard', :modular_headers => true

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 refuses the 12.0 deployment target of the SQLCipher and ZIPFoundation pods that SQLite brings.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_configuration|
        if build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
          build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
    end
  end
end

# Capacitor builds as dynamic frameworks: as static libraries, pod install fails because the Capacitor Swift pod imports CapacitorCordova, which defines no module.
dynamic_frameworks = ['Capacitor', 'CapacitorCordova']
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if dynamic_frameworks.include?(pod.name)
      def pod.static_framework?
        false
      end

      def pod.build_type
        Pod::BuildType.dynamic_framework
      end
    end
  end
end
